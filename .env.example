# Vite đọc env từ thư mục gốc repo (xem app/vite.config.js → envDir).
# Copy thành .env rồi điền giá trị. Không commit file .env.
#
# Production (Vercel, Netlify, …): thêm cùng tên biến trong Settings → Environment Variables
# và build lại — bắt buộc tiền tố VITE_ để Vite nhúng vào bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Tuỳ chọn — ảnh báo cáo / Cloudinary (preset Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_preset_name
