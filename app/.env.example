# Đặt biến trong <repo>/.env hoặc .env.local (thư mục gốc, không phải app/) — xem app/vite.config.js envDir.
# Giá trị lấy từ:
# Supabase Dashboard → Project Settings → API
#
# Project URL → VITE_SUPABASE_URL
# anon / public key → VITE_SUPABASE_PUBLISHABLE_KEY

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Cloudinary — ảnh báo cáo / Sửa công việc (upload unsigned + preset)
# Dashboard → Settings → Upload → Add upload preset (Signing mode: Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=F-solution
